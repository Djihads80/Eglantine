<!--
    Console-style Home (landscape).
    Every ID used by GamesFragment (header, search_*, view/filter/settings buttons, swipe_refresh,
    notice_text, grid_games, add_directory, launch_qlaunch) is preserved. The console_* views are
    driven by org.yuzu.yuzu_emu.ui.home.ConsoleHomeController and only exist in this layout.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/console_home_base_background"
    android:clipChildren="false">

    <!-- Dynamic backdrop: two layers cross-faded by ConsoleHomeController -->
    <ImageView
        android:id="@+id/console_backdrop_a"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/console_backdrop_b"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/console_backdrop_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/console_home_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.25"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/console_home_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/frame_search"
            android:layout_width="@dimen/console_home_search_width"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_background"
                style="@style/EdenCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_home_header_icon"
                android:background="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/console_home_outline_dim"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="36dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/console_home_text_secondary" />

                    <EditText
                        android:id="@+id/search_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/home_search_games"
                        android:imeOptions="flagNoFullscreen"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/console_home_text_primary"
                        android:textColorHint="@color/console_home_text_dim"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/clear_button"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clear"
                    android:visibility="invisible"
                    app:tint="@color/console_home_text_secondary" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_button"
            style="@style/EdenCard"
            android:layout_width="@dimen/console_home_header_icon"
            android:layout_height="@dimen/console_home_header_icon"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/console_home_outline_dim"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eye"
                app:tint="@color/console_home_text_primary" />

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filter_button"
            style="@style/EdenCard"
            android:layout_width="@dimen/console_home_header_icon"
            android:layout_height="@dimen/console_home_header_icon"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/console_home_outline_dim"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_filter"
                app:tint="@color/console_home_text_primary" />

        </com.google.android.material.card.MaterialCardView>

        <TextClock
            android:id="@+id/console_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textColor="@color/console_home_text_primary"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_button"
            style="@style/EdenCard"
            android:layout_width="@dimen/console_home_header_icon"
            android:layout_height="@dimen/console_home_header_icon"
            android:background="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/console_home_outline_dim"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                app:tint="@color/console_home_text_primary" />

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/console_profile_button"
            style="@style/EdenCard"
            android:layout_width="@dimen/console_home_header_icon"
            android:layout_height="@dimen/console_home_header_icon"
            android:background="@android:color/transparent"
            android:contentDescription="@string/profile_manager"
            app:cardBackgroundColor="@color/console_home_focus_fill"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/console_home_text_primary"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_account_circle"
                app:tint="@color/console_home_text_primary" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Game carousel (main element) -->
    <org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@+id/console_details"
        app:layout_constraintTop_toBottomOf="@id/header">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/spacing_large"
                android:text="@string/empty_gamelist"
                android:textColor="@color/console_home_text_secondary"
                android:visibility="gone" />

            <org.yuzu.yuzu_emu.ui.CarouselRecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

        </RelativeLayout>

    </org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout>

    <!-- Selected game details -->
    <LinearLayout
        android:id="@+id/console_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/console_dock"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxWidth="560dp"
            android:singleLine="true"
            android:textColor="@color/console_home_text_primary"
            android:textSize="24sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_game_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxWidth="560dp"
            android:singleLine="true"
            android:textColor="@color/console_home_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_play_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/console_home_button_height"
                android:background="@drawable/console_play_button_background"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="26dp"
                android:text="@string/home_console_play"
                android:textColor="@color/console_home_play_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_play"
                app:drawableTint="@color/console_home_play_text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_options_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/console_home_button_height"
                android:layout_marginStart="10dp"
                android:background="@drawable/console_secondary_button_background"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/home_console_options"
                android:textColor="@color/console_home_text_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_more_vert"
                app:drawableTint="@color/console_home_text_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_info_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/console_home_button_height"
                android:layout_marginStart="10dp"
                android:background="@drawable/console_secondary_button_background"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/home_console_info"
                android:textColor="@color/console_home_text_primary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_info_outline"
                app:drawableTint="@color/console_home_text_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/home_console_hints"
                android:textColor="@color/console_home_text_dim"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom dock (secondary menus) -->
    <LinearLayout
        android:id="@+id/console_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/console_dock_library"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_cartridge" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/home_console_library" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_dock_install"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_install" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/install" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_dock_settings"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_settings" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/preferences_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_dock_applets"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_applet" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/home_console_applets" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_dock_multiplayer"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_two_users" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/multiplayer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/console_dock_about"
            style="@style/ConsoleDockItem">

            <ImageView
                style="@style/ConsoleDockIcon"
                android:src="@drawable/ic_info_outline" />

            <TextView
                style="@style/ConsoleDockLabel"
                android:text="@string/about" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_directory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Select_game_folder"
        android:text="@string/folder"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_cartridge_outline"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#99FFFFFF" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/launch_qlaunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Launch QLaunch"
        android:text="@string/qlaunch_applet"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_home"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="#99FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
