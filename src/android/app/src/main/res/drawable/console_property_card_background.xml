<!-- Game screen option card: translucent surface, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/console_home_text_primary" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/console_home_focus_fill" /><stroke android:width="1dp" android:color="@color/console_home_outline" /></shape></item>
    <item><shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/console_home_surface" /><stroke android:width="1dp" android:color="@color/console_home_surface_stroke" /></shape></item>
</selector>
