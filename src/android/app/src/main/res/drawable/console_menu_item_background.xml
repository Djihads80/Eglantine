<!-- Gear menu entry: white when focused (gamepad), translucent when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="@color/console_home_text_primary" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="10dp" /><solid android:color="@color/console_home_focus_fill" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>
