<!-- Console-style Home and game screen: colors, dimensions and tuning values.
     Defaults target landscape; values-port/console_home_port.xml overrides portrait. -->
<resources>
    <!-- Background gradient (dark navy to soft blue-grey) -->
    <color name="console_home_bg_top">#FF0A1238</color>
    <color name="console_home_bg_center">#FF1B2C66</color>
    <color name="console_home_bg_bottom">#FF5B6F98</color>

    <color name="console_home_text_primary">#FFFFFFFF</color>
    <color name="console_home_text_secondary">#FFC3CEE3</color>
    <color name="console_home_text_dim">#FF8E9BB8</color>
    <color name="console_home_text_on_light">#FF0B1A3E</color>
    <color name="console_home_text_on_light_secondary">#FF4A5878</color>
    <color name="console_home_text_danger">#FFFF9C9C</color>
    <color name="console_home_outline">#80FFFFFF</color>
    <color name="console_home_outline_dim">#40FFFFFF</color>
    <color name="console_home_focus_fill">#26FFFFFF</color>
    <color name="console_home_surface">#1FFFFFFF</color>
    <color name="console_home_surface_stroke">#26FFFFFF</color>
    <color name="console_home_chip">#26FFFFFF</color>
    <color name="console_home_chip_on_light">#1A0B1A3E</color>
    <color name="console_home_card_bg">#FF1A2A5A</color>
    <color name="console_home_battery_low">#FFFF7A7A</color>

    <dimen name="console_home_header_button">41dp</dimen>
    <dimen name="console_home_header_button_radius">20.5dp</dimen>
    <dimen name="console_home_header_icon">19dp</dimen>
    <dimen name="console_home_search_height">48dp</dimen>
    <dimen name="console_home_side_margin">48dp</dimen>
    <!-- Top bar sits close to the screen corners. -->
    <dimen name="console_home_header_margin">14dp</dimen>
    <dimen name="console_home_header_margin_top">10dp</dimen>
    <dimen name="console_home_title_size">28sp</dimen>
    <dimen name="console_home_meta_size">14sp</dimen>
    <dimen name="console_home_details_margin_top">8dp</dimen>
    <dimen name="console_home_carousel_margin_bottom">8dp</dimen>
    <dimen name="console_home_card_gap">14dp</dimen>
    <dimen name="console_home_card_radius">14dp</dimen>
    <dimen name="console_home_play_min_width">200dp</dimen>
    <dimen name="console_home_play_height">52dp</dimen>
    <dimen name="console_home_play_margin_bottom">28dp</dimen>
    <dimen name="console_home_glyph_size">22dp</dimen>
    <dimen name="console_home_details_shift">6dp</dimen>
    <dimen name="console_game_cover_size">170dp</dimen>
    <dimen name="console_game_title_size">30sp</dimen>

    <!-- Size of the centered card relative to the carousel height. -->
    <fraction name="console_home_card_size_factor">92%</fraction>
    <!-- Max centered card size relative to the carousel width. -->
    <fraction name="console_home_card_max_width_factor">59%</fraction>
    <!-- Centered card size relative to the shortest screen side. Not overridden per orientation,
         so tiles keep the same size in portrait and landscape (bounded by the carousel height). -->
    <fraction name="console_home_card_screen_factor">66%</fraction>
    <!-- Scale and alpha applied to the non-selected neighbours. -->
    <fraction name="console_home_side_scale">76%</fraction>
    <fraction name="console_home_side_alpha">100%</fraction>

    <integer name="console_home_details_fade_ms">200</integer>
    <integer name="console_game_property_columns">2</integer>

    <style name="ConsoleHeaderButton">
        <item name="android:layout_width">@dimen/console_home_header_button</item>
        <item name="android:layout_height">@dimen/console_home_header_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="cardBackgroundColor">@color/console_home_text_primary</item>
        <item name="cardCornerRadius">@dimen/console_home_header_button_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/console_home_chip_on_light</item>
    </style>

    <style name="ShapeAppearance.Console.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ConsoleHeaderIcon">
        <item name="android:layout_width">@dimen/console_home_header_icon</item>
        <item name="android:layout_height">@dimen/console_home_header_icon</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/console_home_text_on_light</item>
    </style>

    <style name="ConsoleMetaText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/console_home_meta_size</item>
        <item name="android:textColor">@color/console_home_text_secondary</item>
    </style>

    <style name="ConsoleGlyph">
        <item name="android:layout_width">@dimen/console_home_glyph_size</item>
        <item name="android:layout_height">@dimen/console_home_glyph_size</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="ConsoleGlyph.Light">
        <item name="android:background">@drawable/console_glyph_light</item>
        <item name="android:textColor">@color/console_home_text_on_light</item>
    </style>

    <style name="ConsoleGlyph.Dark">
        <item name="android:background">@drawable/console_glyph_dark</item>
        <item name="android:textColor">@color/console_home_text_primary</item>
    </style>

    <!-- Small round icon button (import / export / share). Solid so it reads on both the
         translucent card and the white focused card. -->
    <style name="ConsoleSecondaryAction" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/console_home_text_primary</item>
        <item name="backgroundTint">@color/console_home_card_bg</item>
        <item name="strokeColor">@color/console_secondary_action_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="ConsoleTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@drawable/console_tab_background</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/console_tab_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Game screen Play button (next to the tabs in landscape, under the cover in portrait). -->
    <style name="ConsolePlayButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">150dp</item>
        <item name="android:paddingHorizontal">22dp</item>
        <item name="android:text">@string/home_console_play</item>
        <item name="android:textColor">@color/console_home_text_on_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/console_play_tint</item>
        <item name="cornerRadius">24dp</item>
        <item name="icon">@drawable/ic_play</item>
        <item name="iconTint">@color/console_home_text_on_light</item>
        <item name="strokeColor">@color/console_secondary_action_stroke</item>
        <item name="strokeWidth">3dp</item>
    </style>

    <style name="ConsoleInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/console_home_text_secondary</item>
    </style>

    <style name="ConsoleHintLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/console_home_text_secondary</item>
    </style>
</resources>
