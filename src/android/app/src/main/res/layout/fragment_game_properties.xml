<!--
    Console-style game screen, single column (portrait): game card, Play, then tabbed options.
    IDs shared with layout-w600dp/fragment_game_properties.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/console_home_base_background">

    <!-- Top bar: back + breadcrumb | shortcut, clock, Wi-Fi/battery -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/console_home_side_margin"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/button_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_back"
            app:iconSize="22dp"
            app:iconTint="@color/console_home_text_primary" />

        <TextView
            android:id="@+id/console_breadcrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.2"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/console_home_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_shortcut"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/game_console_shortcut"
            app:icon="@drawable/ic_shortcut"
            app:iconSize="22dp"
            app:iconTint="@color/console_home_text_primary" />

        <TextClock
            android:id="@+id/console_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/console_home_text_primary"
            android:textSize="18sp" />

        <org.yuzu.yuzu_emu.views.ConsoleStatusView
            android:id="@+id/console_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/list_all"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/console_hints"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/layout_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/console_home_side_margin"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/icon_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/console_game_cover_size"
                    android:layout_height="@dimen/console_game_cover_size"
                    android:layout_gravity="center_horizontal"
                    app:cardBackgroundColor="@color/console_home_card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/console_home_text_primary"
                    app:strokeWidth="3dp">

                    <ImageView
                        android:id="@+id/image_game_screen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxWidth="320dp"
                        android:requiresFadingEdge="horizontal"
                        android:singleLine="true"
                        android:textColor="@color/console_home_text_primary"
                        android:textSize="@dimen/console_game_title_size" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/console_game_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:textColor="@color/console_home_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/console_game_developer"
                    style="@style/ConsoleMetaText"
                    android:layout_gravity="center_horizontal" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/playtime"
                    style="@style/ConsoleMetaText"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:paddingHorizontal="6dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/console_game_file_info"
                    style="@style/ConsoleMetaText"
                    android:layout_gravity="center_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_start"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:minWidth="180dp"
                    android:text="@string/home_console_play"
                    android:textColor="@color/console_home_text_on_light"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/console_play_tint"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/console_home_text_on_light"
                    app:strokeColor="@color/console_secondary_action_stroke"
                    app:strokeWidth="3dp" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/console_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_settings"
                        style="@style/ConsoleTab"
                        android:text="@string/game_console_tab_settings" />

                    <TextView
                        android:id="@+id/tab_content"
                        style="@style/ConsoleTab"
                        android:text="@string/game_console_tab_content" />

                    <TextView
                        android:id="@+id/tab_data"
                        style="@style/ConsoleTab"
                        android:text="@string/game_console_tab_data" />

                </LinearLayout>

            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_properties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/card_console_property" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Gamepad hints (only shown with a controller connected) -->
    <LinearLayout
        android:id="@+id/console_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/console_home_side_margin"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/console_hint_confirm_glyph"
            style="@style/ConsoleGlyph.Light"
            android:text="A" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/game_console_select" />

        <TextView
            style="@style/ConsoleGlyph.Light"
            android:text="X" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/home_console_play" />

        <TextView
            android:id="@+id/console_hint_back_glyph"
            style="@style/ConsoleGlyph.Light"
            android:text="B" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/back" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
