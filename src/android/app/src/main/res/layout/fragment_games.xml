<!--
    Console-style Home (portrait and landscape).
    Every ID used by GamesFragment (header, search_*, view/filter/settings buttons, swipe_refresh,
    notice_text, grid_games, add_directory, launch_qlaunch) is preserved. The console_* views are
    driven by org.yuzu.yuzu_emu.ui.home.ConsoleHomeController.
    View/filter buttons stay hidden: they are reached from the gear menu.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/console_home_base_background"
    android:clipChildren="false">

    <!-- Top bar: gear (menu) | search (on demand) | clock, Wi-Fi/battery, profile -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/console_home_side_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_button"
            style="@style/ConsoleHeaderButton"
            android:contentDescription="@string/home_console_menu">

            <ImageView
                style="@style/ConsoleHeaderIcon"
                android:src="@drawable/ic_settings" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:visibility="gone" />

        <Space
            android:id="@+id/console_header_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/frame_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_background"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_home_header_button"
                app:cardBackgroundColor="@color/console_home_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/console_home_outline_dim"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="42dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/console_home_text_secondary" />

                    <EditText
                        android:id="@+id/search_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="@string/home_search_games"
                        android:imeOptions="flagNoFullscreen|actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/console_home_text_primary"
                        android:textColorHint="@color/console_home_text_dim"
                        android:textSize="15sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/clear_button"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clear"
                    android:visibility="invisible"
                    app:tint="@color/console_home_text_secondary" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Kept for GamesFragment (view / sort menus); opened from the gear menu. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filter_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/console_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/console_home_text_primary"
            android:textSize="18sp" />

        <org.yuzu.yuzu_emu.views.ConsoleStatusView
            android:id="@+id/console_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/console_profile_button"
            style="@style/ConsoleHeaderButton"
            android:contentDescription="@string/profile_manager">

            <ImageView
                style="@style/ConsoleHeaderIcon"
                android:src="@drawable/ic_account_circle" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Selected game details -->
    <LinearLayout
        android:id="@+id/console_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/console_home_side_margin"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_game_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="640dp"
                android:singleLine="true"
                android:textColor="@color/console_home_text_primary"
                android:textSize="@dimen/console_home_title_size" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/console_game_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="@color/console_home_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_meta_developer"
            style="@style/ConsoleMetaText"
            android:layout_marginTop="8dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_meta_playtime"
            style="@style/ConsoleMetaText" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_meta_format"
            style="@style/ConsoleMetaText" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/console_meta_size"
            style="@style/ConsoleMetaText" />

    </LinearLayout>

    <!-- Game carousel (main element) -->
    <org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/console_play_button"
        app:layout_constraintTop_toBottomOf="@id/console_details">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/spacing_large"
                android:text="@string/empty_gamelist"
                android:textColor="@color/console_home_text_secondary"
                android:visibility="gone" />

            <org.yuzu.yuzu_emu.ui.CarouselRecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />

        </RelativeLayout>

    </org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout>

    <!-- Primary action -->
    <LinearLayout
        android:id="@+id/console_play_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/console_home_play_height"
        android:layout_marginBottom="@dimen/console_home_play_margin_bottom"
        android:background="@drawable/console_play_button_background"
        android:clickable="true"
        android:contentDescription="@string/home_console_play"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/console_home_play_min_width"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/console_hints"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/console_play_glyph"
            style="@style/ConsoleGlyph.Dark"
            android:text="A" />

        <ImageView
            android:id="@+id/console_play_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            app:tint="@color/console_home_text_on_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:text="@string/home_console_play"
            android:textColor="@color/console_home_text_on_light"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Gamepad hints (only shown with a controller connected) -->
    <LinearLayout
        android:id="@+id/console_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/console_home_side_margin"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/console_hint_confirm_glyph"
            style="@style/ConsoleGlyph.Light"
            android:text="A" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/home_console_play" />

        <TextView
            style="@style/ConsoleGlyph.Light"
            android:text="X" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/home_console_options" />

        <TextView
            style="@style/ConsoleGlyph.Light"
            android:text="Y" />

        <TextView
            style="@style/ConsoleHintLabel"
            android:text="@string/home_console_search" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_directory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Select_game_folder"
        android:text="@string/folder"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_cartridge_outline"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="#99FFFFFF" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/launch_qlaunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Launch QLaunch"
        android:text="@string/qlaunch_applet"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_home"
        app:iconTint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="#99FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
