<!-- Entry of the console Home gear menu (ConsoleHomeController.showMenu). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/console_menu_item_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/console_menu_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        app:tint="@color/console_menu_text" />

    <TextView
        android:id="@+id/console_menu_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:textColor="@color/console_menu_text"
        android:textSize="15sp" />

</LinearLayout>
